# Copy to .env.production and fill in real values.
# Used with: docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# These values match k8s/secret.yaml for parity across deployment targets.

# --- App / auth ---
APP_NAME=VRP Logistics Optimizer
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Redis (required for caching / progress WebSocket) ---
REDIS_PASSWORD=CHANGE-ME
REDIS_URL=redis://:CHANGE-ME@localhost:6379/0

# --- PostgreSQL (required for job persistence / multi-tenant) ---
POSTGRES_PASSWORD=CHANGE-ME
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE-ME@localhost:5432/vrp

# --- Routing ---
ROUTING_BACKEND=haversine        # haversine | osrm | ors
ORS_API_KEY=
OSRM_BASE_URL=http://router.project-osrm.org
OSRM_BATCH_SIZE=100
ORS_BATCH_SIZE=50

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=

# OTLP gRPC endpoint (optional) — leave empty to keep tracing disabled.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=vrp-backend

# --- Solver ---
SOLVER_TIME_LIMIT_SECONDS=60
DEFAULT_MAX_VEHICLES=18
DEFAULT_VEHICLE_CAPACITY=50

# --- Billing / notifications (optional) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
