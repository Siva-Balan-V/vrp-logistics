# Active blue/green frontend. Generated by scripts/deploy.sh on each flip
# from router.conf.template. The placeholder __FRONTEND_SERVICE__ is replaced
# with vrp-frontend-blue or vrp-frontend-green.

upstream active_frontend {
    server __FRONTEND_SERVICE__:80;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    client_max_body_size 10m;

    location / {
        proxy_pass http://active_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
