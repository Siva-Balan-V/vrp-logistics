# ── Required ────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production

# ── Routing ────────────────────────────────────
ROUTING_BACKEND=haversine        # "haversine" | "osrm" | "ors"
ORS_API_KEY=                     # Only if using ORS backend
OSRM_BASE_URL=http://router.project-osrm.org

# ── Redis (Docker compose only) ────────────────
REDIS_PASSWORD=change-me-in-production

# ── PostgreSQL (Docker compose only) ───────────
POSTGRES_PASSWORD=change-me-in-production

# ── JWT ────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Solver ─────────────────────────────────────
SOLVER_TIME_LIMIT_SECONDS=60
FUEL_COST_PER_KM=0.35
DRIVER_COST_PER_HOUR=25.0

# ── Logging ────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console               # "console" | "json"
# LOG_FILE=/var/log/vrp/backend.log

# ── Tracing (OpenTelemetry / OTLP) ─────────────
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to keep tracing fully disabled.
# Set it to an OTLP gRPC collector (e.g. http://localhost:4317) to enable.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=vrp-backend

# ── Stripe / Billing ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ── Notifications ─────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
